# Nombres de variables y secretos del Worker. Copiar a `.dev.vars` para desarrollo
# local y rellenar; en producción usar `npx wrangler secret put <NOMBRE>`.
# JAMÁS poner valores reales en este archivo ni en el repositorio.

# Meta / Instagram
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# IA (solo si AI_PROVIDER=external-http)
AI_EXTERNAL_ENDPOINT=
AI_EXTERNAL_API_KEY=

# Las variables no sensibles (APP_ENV, BUSINESS_TIMEZONE, AI_PROVIDER, AI_MODE,
# META_GRAPH_VERSION) viven en `wrangler.jsonc` bajo `vars`.
